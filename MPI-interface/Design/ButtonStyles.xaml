<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Один шаблон: цвет задаёт стиль через TemplateBinding Background/Foreground. -->
    <Style x:Key="Button.Muted" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Button.Muted.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Button.Muted.Foreground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Button.Medium}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Base}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodyMedium}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Medium}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Accent"
           TargetType="Button"
           BasedOn="{StaticResource Button.Muted}">
        <Setter Property="Background" Value="{DynamicResource Brush.Button.Accent.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Button.Accent.Foreground}" />
    </Style>
</ResourceDictionary>

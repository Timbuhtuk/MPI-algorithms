<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Минимальный шаблон: без триггеров; отступ из Foundation через DynamicResource. -->
    <Style x:Key="TextBox.Sonar" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Input.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Input.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Input.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Base}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{DynamicResource Brush.Input.Background}"
                            BorderBrush="{DynamicResource Brush.Input.Border}"
                            BorderThickness="1"
                            Padding="{DynamicResource Padding.Input}"
                            CornerRadius="{DynamicResource Radius.Medium}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Margin="0"
                                      VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

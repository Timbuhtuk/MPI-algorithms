<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================
         COLORS
         ========================= -->

    <!-- Backgrounds -->
    <Color x:Key="Color.Background.App">#000000</Color>
    <Color x:Key="Color.Background.Body">#0A0A0A</Color>
    <Color x:Key="Color.Background.Page">#151515</Color>
    <Color x:Key="Color.Background.Modal">#0A0A0A</Color>

    <!-- Text -->
    <Color x:Key="Color.Text.Primary">#FFFFFF</Color>
    <Color x:Key="Color.Text.Secondary">#EAEAEA</Color>
    <Color x:Key="Color.Text.Subtle">#99FFFFFF</Color>
    <Color x:Key="Color.Text.Subtitle">#999999</Color>
    <Color x:Key="Color.Text.Dark">#1F1F1F</Color>

    <!-- Accent -->
    <Color x:Key="Color.Accent.Error">#FF3B30</Color>
    <Color x:Key="Color.Accent.ErrorFocus">#FF453A</Color>
    <Color x:Key="Color.Accent.LinkHover">#409CFF</Color>
    <Color x:Key="Color.Accent.LinkActive">#0070E0</Color>
    <Color x:Key="Color.Accent.Like">#FF3B5C</Color>
    <Color x:Key="Color.Accent.LikeHover">#FF1744</Color>
    <Color x:Key="Color.Accent.Success">#4CAF50</Color>

    <!-- Buttons -->
    <Color x:Key="Color.Button.Light.Background">#FFFFFF</Color>
    <Color x:Key="Color.Button.Light.BackgroundPressed">#D8D8D8</Color>
    <Color x:Key="Color.Button.Light.Foreground">#1F1F1F</Color>
    <Color x:Key="Color.Button.Light.ForegroundHover">#4C4C4C</Color>
    <Color x:Key="Color.Button.Light.SelectedBackground">#EAEAEA</Color>
    <Color x:Key="Color.Button.Light.SelectedHover">#D8D8D8</Color>
    <Color x:Key="Color.Button.Light.SelectedPressed">#C8C8C8</Color>

    <Color x:Key="Color.Button.Dark.Background">#1F1F1F</Color>
    <Color x:Key="Color.Button.Dark.BackgroundPressed">#272727</Color>
    <Color x:Key="Color.Button.Dark.Foreground">#EAEAEA</Color>
    <Color x:Key="Color.Button.Dark.ForegroundHover">#C8C8C8</Color>
    <Color x:Key="Color.Button.Dark.SelectedBackground">#CCFFFFFF</Color>
    <Color x:Key="Color.Button.Dark.SelectedHover">#E6FFFFFF</Color>
    <Color x:Key="Color.Button.Dark.SelectedPressed">#B3FFFFFF</Color>
    <Color x:Key="Color.Button.Disabled.Background">#AEAEAE</Color>
    <Color x:Key="Color.Button.Disabled.Foreground">#6A6A6A</Color>

    <!-- Input -->
    <Color x:Key="Color.Input.Background">#1F1F1F</Color>
    <Color x:Key="Color.Input.Foreground">#FFFFFF</Color>
    <Color x:Key="Color.Input.Label">#99FFFFFF</Color>
    <Color x:Key="Color.Input.Placeholder">#6A6A6A</Color>
    <Color x:Key="Color.Input.Border">#2C2C2E</Color>
    <Color x:Key="Color.Input.BorderFocus">#3A3A3C</Color>
    <Color x:Key="Color.Input.DisabledBackground">#0D0D0D</Color>
    <Color x:Key="Color.Input.DisabledForeground">#4A4A4A</Color>
    <Color x:Key="Color.Input.DisabledPlaceholder">#3A3A3A</Color>

    <!-- Cards / TabBar / Misc -->
    <Color x:Key="Color.Card.Background">#26D9D9D9</Color>
    <Color x:Key="Color.Card.Placeholder">#4DD9D9D9</Color>
    <Color x:Key="Color.TabBar.Background">#1F1F1F</Color>
    <Color x:Key="Color.TabBar.ActiveBackground">#FFFFFF</Color>
    <Color x:Key="Color.TabBar.HoverBackground">#1AFFFFFF</Color>
    <Color x:Key="Color.TabBar.ActiveHoverBackground">#E8E8E8</Color>
    <Color x:Key="Color.Backdrop">#66000000</Color>

    <!-- Folder -->
    <Color x:Key="Color.Folder.Layer1">#969696</Color>
    <Color x:Key="Color.Folder.Layer2">#B4B4B4</Color>
    <Color x:Key="Color.Folder.Layer3">#D9D9D9</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Background.App" Color="{StaticResource Color.Background.App}" />
    <SolidColorBrush x:Key="Brush.Background.Body" Color="{StaticResource Color.Background.Body}" />
    <SolidColorBrush x:Key="Brush.Background.Page" Color="{StaticResource Color.Background.Page}" />
    <SolidColorBrush x:Key="Brush.Background.Modal" Color="{StaticResource Color.Background.Modal}" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Subtle" Color="{StaticResource Color.Text.Subtle}" />
    <SolidColorBrush x:Key="Brush.Text.Subtitle" Color="{StaticResource Color.Text.Subtitle}" />
    <SolidColorBrush x:Key="Brush.Text.Dark" Color="{StaticResource Color.Text.Dark}" />

    <SolidColorBrush x:Key="Brush.Accent.Error" Color="{StaticResource Color.Accent.Error}" />
    <SolidColorBrush x:Key="Brush.Accent.Success" Color="{StaticResource Color.Accent.Success}" />
    <SolidColorBrush x:Key="Brush.Backdrop" Color="{StaticResource Color.Backdrop}" />

    <SolidColorBrush x:Key="Brush.Button.Light.Background" Color="{StaticResource Color.Button.Light.Background}" />
    <SolidColorBrush x:Key="Brush.Button.Light.BackgroundPressed" Color="{StaticResource Color.Button.Light.BackgroundPressed}" />
    <SolidColorBrush x:Key="Brush.Button.Light.Foreground" Color="{StaticResource Color.Button.Light.Foreground}" />
    <SolidColorBrush x:Key="Brush.Button.Light.ForegroundHover" Color="{StaticResource Color.Button.Light.ForegroundHover}" />
    <SolidColorBrush x:Key="Brush.Button.Light.SelectedBackground" Color="{StaticResource Color.Button.Light.SelectedBackground}" />

    <SolidColorBrush x:Key="Brush.Button.Dark.Background" Color="{StaticResource Color.Button.Dark.Background}" />
    <SolidColorBrush x:Key="Brush.Button.Dark.BackgroundPressed" Color="{StaticResource Color.Button.Dark.BackgroundPressed}" />
    <SolidColorBrush x:Key="Brush.Button.Dark.Foreground" Color="{StaticResource Color.Button.Dark.Foreground}" />
    <SolidColorBrush x:Key="Brush.Button.Dark.ForegroundHover" Color="{StaticResource Color.Button.Dark.ForegroundHover}" />
    <SolidColorBrush x:Key="Brush.Button.Dark.SelectedBackground" Color="{StaticResource Color.Button.Dark.SelectedBackground}" />

    <SolidColorBrush x:Key="Brush.Button.Disabled.Background" Color="{StaticResource Color.Button.Disabled.Background}" />
    <SolidColorBrush x:Key="Brush.Button.Disabled.Foreground" Color="{StaticResource Color.Button.Disabled.Foreground}" />

    <SolidColorBrush x:Key="Brush.Input.Background" Color="{StaticResource Color.Input.Background}" />
    <SolidColorBrush x:Key="Brush.Input.Foreground" Color="{StaticResource Color.Input.Foreground}" />
    <SolidColorBrush x:Key="Brush.Input.Border" Color="{StaticResource Color.Input.Border}" />
    <SolidColorBrush x:Key="Brush.Input.BorderFocus" Color="{StaticResource Color.Input.BorderFocus}" />
    <SolidColorBrush x:Key="Brush.Input.DisabledBackground" Color="{StaticResource Color.Input.DisabledBackground}" />
    <SolidColorBrush x:Key="Brush.Input.DisabledForeground" Color="{StaticResource Color.Input.DisabledForeground}" />
    <SolidColorBrush x:Key="Brush.Input.Label" Color="{StaticResource Color.Input.Label}" />
    <SolidColorBrush x:Key="Brush.Input.Placeholder" Color="{StaticResource Color.Input.Placeholder}" />

    <SolidColorBrush x:Key="Brush.TabBar.Background" Color="{StaticResource Color.TabBar.Background}" />
    <SolidColorBrush x:Key="Brush.TabBar.ActiveBackground" Color="{StaticResource Color.TabBar.ActiveBackground}" />
    <SolidColorBrush x:Key="Brush.TabBar.HoverBackground" Color="{StaticResource Color.TabBar.HoverBackground}" />
    <SolidColorBrush x:Key="Brush.TabBar.ActiveHoverBackground" Color="{StaticResource Color.TabBar.ActiveHoverBackground}" />

    <SolidColorBrush x:Key="Brush.Folder.Layer1" Color="{StaticResource Color.Folder.Layer1}" />
    <SolidColorBrush x:Key="Brush.Folder.Layer2" Color="{StaticResource Color.Folder.Layer2}" />
    <SolidColorBrush x:Key="Brush.Folder.Layer3" Color="{StaticResource Color.Folder.Layer3}" />

    <!-- =========================
         TYPOGRAPHY
         ========================= -->

    <!-- Fonts -->
    <FontFamily x:Key="FontFamily.Base">Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamily.Accent">Times New Roman</FontFamily>
    <!-- Если подключишь Roboto / Philosopher в проект, просто замени -->

    <!-- Sizes -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.PageTitle">32</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.PageHeader">24</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.SectionTitle">20</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Subtitle">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Body">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.BodyMedium">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Caption">12</sys:Double>

    <!-- =========================
         SPACING
         ========================= -->

    <Thickness x:Key="Spacing.4">4</Thickness>
    <Thickness x:Key="Spacing.8">8</Thickness>
    <Thickness x:Key="Spacing.12">12</Thickness>
    <Thickness x:Key="Spacing.16">16</Thickness>
    <Thickness x:Key="Spacing.20">20</Thickness>
    <Thickness x:Key="Spacing.24">24</Thickness>
    <Thickness x:Key="Spacing.32">32</Thickness>
    <Thickness x:Key="Spacing.64">64</Thickness>

    <Thickness x:Key="Padding.Page">16</Thickness>
    <Thickness x:Key="Padding.Button.Small">10,6</Thickness>
    <Thickness x:Key="Padding.Button.Medium">14,10</Thickness>
    <Thickness x:Key="Padding.Input">16,10</Thickness>
    <Thickness x:Key="Padding.TabBar">8</Thickness>
    <Thickness x:Key="Padding.TabItem">12</Thickness>
    <Thickness x:Key="Padding.TabItem.Active">20,12</Thickness>

    <!-- =========================
         CORNER RADIUS
         ========================= -->

    <CornerRadius x:Key="Radius.Small">8</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">16</CornerRadius>
    <CornerRadius x:Key="Radius.Large">24</CornerRadius>
    <CornerRadius x:Key="Radius.XLarge">32</CornerRadius>
    <CornerRadius x:Key="Radius.Round">999</CornerRadius>

    <!-- =========================
         SHADOW / EFFECT HELPERS
         ========================= -->

    <DropShadowEffect x:Key="Shadow.Popup"
                      BlurRadius="12"
                      ShadowDepth="0"
                      Opacity="0.3" />

</ResourceDictionary>


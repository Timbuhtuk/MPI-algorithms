<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Accent}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.PageTitle}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
<Style x:Key="Text.PageHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Accent}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.PageHeader}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
<Style x:Key="Text.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Accent}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.SectionTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
<Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Base}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
<Style x:Key="Text.BodySecondary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Base}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Subtle}" />
    </Style>
<Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Base}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Subtitle}" />
    </Style>

    <Style x:Key="Text.ResultPrimary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodyMedium}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style x:Key="Text.ResultSecondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Subtle}" />
    </Style>
</ResourceDictionary>

<Window x:Class="MPI_interface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localControls="clr-namespace:MPI_interface.Controls"
        xmlns:local="clr-namespace:MPI_interface.Classes"
        mc:Ignorable="d"
        Title="MPI Interface"
        Height="700"
        Width="1000"
        Background="{DynamicResource Brush.Background.App}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:EnumToBoolConverter x:Key="EnumToBoolConverter" />
    </Window.Resources>
    <Grid Background="{DynamicResource Brush.Background.App}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="MPI Sorting Dashboard"
                   Style="{StaticResource Text.PageTitle}"
                   Margin="20,20,20,0" />

        <TabControl Grid.Row="1"
                    Margin="0,8,0,0"
                    Background="{DynamicResource Brush.Background.Page}">
            <!-- Compare Methods -->
            <TabItem Header="Compare Methods">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="20,16,20,8"
                            Style="{StaticResource Card.Border}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="Benchmark Settings"
                                           Style="{StaticResource Text.SectionTitle}" />
                                <TextBlock Text="Choose input size, batch count, and sorting methods to run"
                                           Style="{StaticResource Text.BodySecondary}"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" x:Name="SettingsLeftGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="ElementsCard"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Background="{DynamicResource Brush.Input.Background}"
                                            BorderBrush="{StaticResource Brush.Input.Border}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Medium}"
                                            Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Elements Count"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="0,0,0,6" />
                                            <TextBox x:Name="ElementsCountTextBox"
                                                     Style="{StaticResource TextBox.Sonar}"
                                                     Text="10000" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="ArraysCard"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Background="{DynamicResource Brush.Input.Background}"
                                            BorderBrush="{StaticResource Brush.Input.Border}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Medium}"
                                            Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Arrays Count"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="0,0,0,6" />
                                            <TextBox x:Name="ArraysCountTextBox"
                                                     Style="{StaticResource TextBox.Sonar}"
                                                     Text="10" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="SeedCard"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            Background="{DynamicResource Brush.Input.Background}"
                                            BorderBrush="{StaticResource Brush.Input.Border}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Medium}"
                                            Padding="14"
                                            Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Random Seed (optional)"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="0,0,0,6" />
                                            <TextBox x:Name="SeedTextBox"
                                                     Style="{StaticResource TextBox.Sonar}"
                                                     Text="">
                                                <TextBox.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Leave empty to use a random seed" />
                                                    </ToolTip>
                                                </TextBox.ToolTip>
                                            </TextBox>
                                        </StackPanel>
                                    </Border>

                                    <UniformGrid x:Name="ArrayTypeRow"
                                                 Grid.Row="2"
                                                 Grid.Column="0"
                                                 Grid.ColumnSpan="3"
                                                 Rows="1"
                                                 Margin="0,12,0,0">
                                        <RadioButton Content="Random"
                                                     IsChecked="{Binding SelectedArrayType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Random}"
                                                     Style="{StaticResource RadioButton.Sonar}" />
                                        <RadioButton Content="Reversed"
                                                     IsChecked="{Binding SelectedArrayType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Reversed}"
                                                     Style="{StaticResource RadioButton.Sonar}" />
                                        <RadioButton Content="Almost Sorted"
                                                     IsChecked="{Binding SelectedArrayType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AlmostSorted}"
                                                     Style="{StaticResource RadioButton.Sonar}" />
                                    </UniformGrid>
                                </Grid>

                                <Border Grid.Column="2"
                                        Background="{DynamicResource Brush.Input.Background}"
                                        BorderBrush="{StaticResource Brush.Input.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Medium}"
                                        Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Methods"
                                                   Style="{StaticResource Text.Caption}"
                                                   Margin="0,0,0,10" />

                                        <WrapPanel>
                                            <CheckBox x:Name="QuickSortCheckBox"
                                                      Content="QuickSort"
                                                      IsChecked="True"
                                                      Style="{StaticResource CheckBox.Sonar.Compact}" />
                                            <CheckBox x:Name="MergeSortCheckBox"
                                                      Content="MergeSort"
                                                      IsChecked="True"
                                                      Style="{StaticResource CheckBox.Sonar.Compact}" />
                                            <CheckBox x:Name="HeapSortCheckBox"
                                                      Content="HeapSort"
                                                      IsChecked="True"
                                                      Style="{StaticResource CheckBox.Sonar.Compact}" />
                                            <CheckBox x:Name="TimSortCheckBox"
                                                      Content="TimSort"
                                                      IsChecked="True"
                                                      Style="{StaticResource CheckBox.Sonar.Compact}" />
                                            <CheckBox x:Name="BubbleSortCheckBox"
                                                      Content="BubbleSort"
                                                      IsChecked="True"
                                                      Style="{StaticResource CheckBox.Sonar.Compact}" />
                                            <CheckBox x:Name="InsertionSortCheckBox"
                                                      Content="InsertionSort"
                                                      IsChecked="True"
                                                      Style="{StaticResource CheckBox.Sonar.Compact}" />
                                            <CheckBox x:Name="BogoSortCheckBox"
                                                      Content="BogoSort"
                                                      IsChecked="False"
                                                      Style="{StaticResource CheckBox.Sonar.Compact}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="4"
                                            VerticalAlignment="Stretch">
                                    <Button x:Name="StartBenchmarkButton"
                                            Content="Start Test"
                                            Style="{StaticResource Button.Accent}"
                                            MinWidth="160"
                                            Height="52"
                                            Click="StartBenchmarkButton_Click" />

                                    <TextBlock Text="Creates a task card and runs the selected methods"
                                               Style="{StaticResource Text.Caption}"
                                               Width="160"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <GroupBox Grid.Row="1"
                              Header="Current Tests"
                              Margin="14,8,14,14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <localControls:BenchmarkTaskWidget />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Detailed Algorithm Test -->
            <TabItem Header="Detailed Algorithm Test">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="0,8,0,8">
                    <Border Margin="20,0,20,16"
                            Style="{StaticResource Card.Border}">
                        <StackPanel Margin="4">
                            <TextBlock Text="Detailed Algorithm Test"
                                       Style="{StaticResource Text.SectionTitle}" />
                            <TextBlock Text="One algorithm, sizes from Start to Max by multiplier; each size runs all three array types."
                                       Style="{StaticResource Text.BodySecondary}"
                                       Margin="0,6,0,16" />

                            <TextBlock Text="Algorithm"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,12">
                                <RadioButton x:Name="DetailedQuickRadio"
                                             Content="QuickSort"
                                             GroupName="DetailedAlgo"
                                             IsChecked="True"
                                             Style="{StaticResource RadioButton.Sonar}"
                                             Margin="0,0,12,8" />
                                <RadioButton x:Name="DetailedMergeRadio"
                                             Content="MergeSort"
                                             GroupName="DetailedAlgo"
                                             Style="{StaticResource RadioButton.Sonar}"
                                             Margin="0,0,12,8" />
                                <RadioButton x:Name="DetailedHeapRadio"
                                             Content="HeapSort"
                                             GroupName="DetailedAlgo"
                                             Style="{StaticResource RadioButton.Sonar}"
                                             Margin="0,0,12,8" />
                                <RadioButton x:Name="DetailedTimRadio"
                                             Content="TimSort"
                                             GroupName="DetailedAlgo"
                                             Style="{StaticResource RadioButton.Sonar}"
                                             Margin="0,0,12,8" />
                                <RadioButton x:Name="DetailedBubbleRadio"
                                             Content="BubbleSort"
                                             GroupName="DetailedAlgo"
                                             Style="{StaticResource RadioButton.Sonar}"
                                             Margin="0,0,12,8" />
                                <RadioButton x:Name="DetailedInsertionRadio"
                                             Content="InsertionSort"
                                             GroupName="DetailedAlgo"
                                             Style="{StaticResource RadioButton.Sonar}"
                                             Margin="0,0,12,8" />
                                <RadioButton x:Name="DetailedBogoRadio"
                                             Content="BogoSort"
                                             GroupName="DetailedAlgo"
                                             Style="{StaticResource RadioButton.Sonar}"
                                             Margin="0,0,12,8" />
                                <RadioButton x:Name="DetailedStalinRadio"
                                             Content="StalinSort"
                                             GroupName="DetailedAlgo"
                                             Style="{StaticResource RadioButton.Sonar}"
                                             Margin="0,0,12,8" />
                            </WrapPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="0">
                                    <TextBlock Text="Start size"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,0,0,6" />
                                    <TextBox x:Name="DetailedStartSizeTextBox"
                                           Style="{StaticResource TextBox.Sonar}"
                                           Text="10" />
                                </StackPanel>
                                <StackPanel Grid.Row="0"
                                            Grid.Column="2">
                                    <TextBlock Text="Max size (N)"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,0,0,6" />
                                    <TextBox x:Name="DetailedMaxSizeTextBox"
                                           Style="{StaticResource TextBox.Sonar}"
                                           Text="10000" />
                                </StackPanel>
                                <StackPanel Grid.Row="0"
                                            Grid.Column="4">
                                    <TextBlock Text="Multiplier"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,0,0,6" />
                                    <TextBox x:Name="DetailedMultiplierTextBox"
                                           Style="{StaticResource TextBox.Sonar}"
                                           Text="2" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,12,0,0">
                                    <TextBlock Text="Arrays per size (runs)"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,0,0,6" />
                                    <TextBox x:Name="DetailedRunsPerSizeTextBox"
                                           Style="{StaticResource TextBox.Sonar}"
                                           Text="10" />
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0,12,0,0">
                                    <TextBlock Text="Seed (optional)"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,0,0,6" />
                                    <TextBox x:Name="DetailedSeedTextBox"
                                           Style="{StaticResource TextBox.Sonar}"
                                           Text="" />
                                </StackPanel>
                            </Grid>

                            <Button x:Name="DetailedRunButton"
                                    Content="Run Detailed Test"
                                    Style="{StaticResource Button.Accent}"
                                    MinWidth="200"
                                    Height="48"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,12"
                                    Click="DetailedRunButton_Click" />

                            <TextBlock x:Name="DetailedStatusTextBlock"
                                       Text="Idle"
                                       Style="{StaticResource Text.BodySecondary}"
                                       Margin="0,0,0,8" />

                            <ProgressBar x:Name="DetailedProgressBar"
                                         Height="10"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

<Window x:Class="MPI_interface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localControls="clr-namespace:MPI_interface.Controls"
        xmlns:local="clr-namespace:MPI_interface.Classes"
        mc:Ignorable="d"
        Title="MPI Interface"
        Height="700"
        Width="1000"
        Background="{DynamicResource Brush.Background.App}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
    </Window.Resources>
    <Grid Background="{DynamicResource Brush.Background.App}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="MPI Sorting Dashboard"
                   Style="{StaticResource Text.PageTitle}"
                   Margin="20,20,20,0"/>

        <Border Grid.Row="1"
        Margin="20,16,20,8"
        Style="{StaticResource Card.Border}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0"
                    Margin="0,0,0,16">
                    <TextBlock Text="Benchmark Settings"
                       Style="{StaticResource Text.SectionTitle}"/>
                    <TextBlock Text="Choose input size, batch count, and sorting methods to run"
                       Style="{StaticResource Text.BodySecondary}"
                       Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: numeric settings -->
                    <StackPanel Grid.Column="0">
                        <Border Background="{DynamicResource Brush.Input.Background}"
                        BorderBrush="{StaticResource Brush.Input.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Padding="14"
                        Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Elements Count"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,0,0,6"/>
                                <TextBox x:Name="ElementsCountTextBox"
                                 Style="{StaticResource TextBox.Sonar}"
                                 Text="10000"
                                 MinWidth="180"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Brush.Input.Background}"
                        BorderBrush="{StaticResource Brush.Input.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Padding="14">
                            <StackPanel>
                                <TextBlock Text="Arrays Count"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,0,0,6"/>
                                <TextBox x:Name="ArraysCountTextBox"
                                 Style="{StaticResource TextBox.Sonar}"
                                 Text="10"
                                 MinWidth="180"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                        <RadioButton Content="Random"
                 IsChecked="{Binding SelectedArrayType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Random}"
                 Margin="0,0,12,0"/>

                        <RadioButton Content="Reversed"
                 IsChecked="{Binding SelectedArrayType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Reversed}"
                 Margin="0,0,12,0"/>

                        <RadioButton Content="Almost Sorted"
                 IsChecked="{Binding SelectedArrayType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AlmostSorted}"/>

                    </StackPanel>

                    <!-- Center: methods -->
                    <Border Grid.Column="2"
                    Background="{DynamicResource Brush.Input.Background}"
                    BorderBrush="{StaticResource Brush.Input.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Medium}"
                    Padding="14">
                        <StackPanel>
                            <TextBlock Text="Methods"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,0,0,10"/>

                            <WrapPanel>
                                <!-- QuickSort -->
                                <CheckBox x:Name="QuickSortCheckBox"
              Content="QuickSort"
              IsChecked="True"
              Style="{StaticResource CheckBox.Sonar.Compact}">
                                    <CheckBox.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="QuickSort"
                               FontWeight="Bold"/>
                                                <TextBlock Text="Divide-and-conquer sorting using a pivot to partition the array." Margin="0,4,0,6"/>
                                                <TextBlock Text="Average Time: O(n log n)"/>
                                                <TextBlock Text="Worst Time: O(n²)"/>
                                                <TextBlock Text="Memory: O(log n) stack"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>


                                <!-- MergeSort -->
                                <CheckBox x:Name="MergeSortCheckBox"
              Content="MergeSort"
              IsChecked="True"
              Style="{StaticResource CheckBox.Sonar.Compact}">
                                    <CheckBox.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="MergeSort"
                               FontWeight="Bold"/>
                                                <TextBlock Text="Recursively splits array and merges sorted halves." Margin="0,4,0,6"/>
                                                <TextBlock Text="Time Complexity: O(n log n)"/>
                                                <TextBlock Text="Stable: Yes"/>
                                                <TextBlock Text="Memory: O(n) auxiliary array"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>


                                <!-- HeapSort -->
                                <CheckBox x:Name="HeapSortCheckBox"
              Content="HeapSort"
              IsChecked="True"
              Style="{StaticResource CheckBox.Sonar.Compact}">
                                    <CheckBox.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="HeapSort"
                               FontWeight="Bold"/>
                                                <TextBlock Text="Builds a binary heap and repeatedly extracts the maximum element." Margin="0,4,0,6"/>
                                                <TextBlock Text="Time Complexity: O(n log n)"/>
                                                <TextBlock Text="Stable: No"/>
                                                <TextBlock Text="Memory: O(1)"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>


                                <!-- TimSort -->
                                <CheckBox x:Name="TimSortCheckBox"
              Content="TimSort"
              IsChecked="True"
              Style="{StaticResource CheckBox.Sonar.Compact}">
                                    <CheckBox.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="TimSort"
                               FontWeight="Bold"/>
                                                <TextBlock Text="Hybrid merge + insertion sort optimized for partially sorted data." Margin="0,4,0,6"/>
                                                <TextBlock Text="Worst Time: O(n log n)"/>
                                                <TextBlock Text="Best Time: O(n)"/>
                                                <TextBlock Text="Memory: O(n)"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>


                                <!-- BubbleSort -->
                                <CheckBox x:Name="BubbleSortCheckBox"
              Content="BubbleSort"
              IsChecked="True"
              Style="{StaticResource CheckBox.Sonar.Compact}">
                                    <CheckBox.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="BubbleSort"
                               FontWeight="Bold"/>
                                                <TextBlock Text="Repeatedly swaps adjacent elements until the array is sorted." Margin="0,4,0,6"/>
                                                <TextBlock Text="Worst Time: O(n²)"/>
                                                <TextBlock Text="Best Time: O(n)"/>
                                                <TextBlock Text="Memory: O(1)"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>


                                <!-- InsertionSort -->
                                <CheckBox x:Name="InsertionSortCheckBox"
              Content="InsertionSort"
              IsChecked="True"
              Style="{StaticResource CheckBox.Sonar.Compact}">
                                    <CheckBox.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="InsertionSort"
                               FontWeight="Bold"/>
                                                <TextBlock Text="Builds a sorted array by inserting elements one by one." Margin="0,4,0,6"/>
                                                <TextBlock Text="Worst Time: O(n²)"/>
                                                <TextBlock Text="Best Time: O(n)"/>
                                                <TextBlock Text="Memory: O(1)"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>


                                <!-- BogoSort -->
                                <CheckBox x:Name="BogoSortCheckBox"
              Content="BogoSort"
              IsChecked="False"
              Style="{StaticResource CheckBox.Sonar.Compact}">
                                    <CheckBox.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="BogoSort"
                               FontWeight="Bold"/>
                                                <TextBlock Text="Randomly shuffles the array until it becomes sorted." Margin="0,4,0,6"/>
                                                <TextBlock Text="Average Time: O(n!)"/>
                                                <TextBlock Text="Memory: O(1)"/>
                                                <TextBlock Text="⚠ Extremely slow — use only for tiny arrays."/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right: action -->
                    <StackPanel Grid.Column="4"
                        VerticalAlignment="Stretch">
                        <Button x:Name="StartBenchmarkButton"
                        Content="Start Test"
                        Style="{StaticResource Button.Light}"
                        MinWidth="160"
                        Height="52"
                        Click="StartBenchmarkButton_Click"/>

                        <TextBlock Text="Creates a task card and runs the selected methods"
                           Style="{StaticResource Text.Caption}"
                           Width="160"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <GroupBox Grid.Row="2"
                  Header="Current Tests"
                  Margin="14,8,14,14">
            <GroupBox Grid.Row="2"
          Header="Current Tests"
          Margin="14,8,14,14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                                <localControls:BenchmarkTaskWidget/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</GroupBox>
        </GroupBox>
    </Grid>
</Window>
<Window x:Class="MPI_interface.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="Benchmark Results"
        Height="620"
        Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background.App}">

        <Grid Background="{DynamicResource Brush.Background.App}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Margin="20,20,20,8"
                Background="Transparent">
            <StackPanel>
                <TextBlock Text="Benchmark Results"
                           Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Text="Execution time overview"
                           Style="{StaticResource Text.BodySecondary}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="1" Margin="14,8,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Speed leaderboard -->
            <GroupBox Grid.Column="0"
                      Header="Speed Leaderboard"
                      Margin="6">
                <ListBox x:Name="TimeResultsListBox"
                         Style="{StaticResource ListBox.Sonar}"
                         ItemContainerStyle="{StaticResource ListBoxItem.Sonar}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding MethodName}"
                                           Style="{StaticResource Text.ResultPrimary}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayTime}"
                                           Style="{StaticResource Text.ResultPrimary}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <!-- Time graph -->
            <GroupBox Grid.Column="1"
                      Header="Time Graph"
                      Margin="6">
                <Grid Margin="4">
                    <ScottPlot:WpfPlot x:Name="PlotTop"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>

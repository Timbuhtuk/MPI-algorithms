<Window x:Class="MPI_interface.DetailedResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Detailed Algorithm Results"
        Height="720"
        Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background.App}">

    <Grid Background="{DynamicResource Brush.Background.App}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,20,20,8">
            <TextBlock x:Name="HeaderTitle"
                       Text="Algorithm"
                       Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="Average time across runs (all three array types)"
                       Style="{StaticResource Text.BodySecondary}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <GroupBox Grid.Row="1"
                  Header="Time vs array size"
                  Margin="14,0,14,14">
            <Grid Margin="4">
                <ScottPlot:WpfPlot x:Name="MainPlot" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>

<UserControl x:Class="MPI_interface.Controls.BenchmarkTaskWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Border Style="{StaticResource Card.Border}"
            Margin="0,0,0,10"
            Padding="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource Text.SectionTitle}"
                           Margin="0,0,0,4"/>

                <TextBlock Text="{Binding Subtitle}"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,0,0,8"/>

                <TextBlock Text="{Binding Status}"
                           Style="{StaticResource Text.Body}"
                           Margin="0,0,0,8"/>

                <Grid Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar Grid.Column="0"
                                 Height="18"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressText}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Style="{StaticResource Text.Caption}"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <Button Content="Open Results"
                        Style="{StaticResource Button.Accent}"
                        MinWidth="140"
                        Height="44"
                        Click="OpenResults_Click"
                        IsEnabled="{Binding CanOpenResults}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>